  "question_item": {
    "description": "Structure of one entry in banks/question-bank.json 'questions'. Vocabulary fields reference ids defined in the sections above.",
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "type": "object",
    "required": [
      "id",
      "status",
      "text",
      "answers",
      "explanation",
      "topics",
      "difficulty",
      "cognitive_level"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string"
      },
      "status": {
        "enum": [
          "active",
          "legacy",
          "needs_source",
          "retired"
        ],
        "x-vocabulary": "item_status"
      },
      "text": {
        "type": "string",
        "description": "Markdown stem; code in fenced java blocks"
      },
      "answers": {
        "type": "array",
        "minItems": 4,
        "maxItems": 5,
        "contains": {
          "properties": {
            "is_correct": {
              "const": true
            }
          }
        },
        "minContains": 1,
        "maxContains": 1,
        "items": {
          "type": "object",
          "required": [
            "text",
            "is_correct",
            "explanation"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "description": "Optional bookkeeping id; choices are shuffled on display"
            },
            "text": {
              "type": "string"
            },
            "is_correct": {
              "type": "boolean"
            },
            "explanation": {
              "type": "string"
            }
          }
        }
      },
      "explanation": {
        "type": "string",
        "description": "Student-facing walkthrough; must not refer to choices by letter"
      },
      "topics": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        },
        "x-vocabulary": "topics"
      },
      "subtopics": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "x-vocabulary": "subtopics"
      },
      "skills": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "x-vocabulary": "skills"
      },
      "common_errors": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "x-vocabulary": "common_errors"
      },
      "question_type": {
        "type": "string",
        "x-vocabulary": "question_types"
      },
      "difficulty": {
        "type": "string",
        "x-vocabulary": "difficulty_levels"
      },
      "cognitive_level": {
        "type": "string",
        "x-vocabulary": "bloom_taxonomy"
      }
    }
  }
}
